# Trading bot configuration — paper trading only; no broker orders are submitted.
# Keep your real .env private. Never commit it to Git or put secrets in a public ZIP.

# This archive currently implements Yahoo Finance only; Upstox is not implemented.

# Optional notifications / AI context
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
NEWS_API_KEY=

# Require both recent NewsAPI headlines and a successful Gemini assessment for new paper BUY signals
REQUIRE_AI_NEWS_CONFIRMATION=true
GEMINI_MODEL=gemini-2.5-flash

# Universe and scan controls
MAX_SCAN_SYMBOLS=250
MAX_BUYS_PER_SCAN=1
MAX_OPEN_POSITIONS=15
SCAN_INTERVAL_MINUTES=15

# Price filter (INR)
MIN_STOCK_PRICE=1
MAX_STOCK_PRICE=1500

# Minimum liquidity over the prior 20 completed sessions
MIN_AVG_DAILY_TURNOVER_INR=20000000
MIN_AVG_DAILY_VOLUME=10000

# Entry / exit indicator thresholds
RSI_BUY_THRESHOLD=50
RSI_MAX_BUY_THRESHOLD=68
RSI_EXIT_THRESHOLD=45

# Prevent re-entry for this many hours after a paper sell
COOLING_PERIOD_HOURS=48

# Yahoo Finance fallback quote settings. Yahoo data may be delayed or incomplete.
YFINANCE_QUOTE_INTERVAL=5m
YFINANCE_MAX_QUOTE_AGE_MINUTES=30

# Dashboard: no login yet; localhost-only and use an SSH tunnel on GCP.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=generate_a_long_random_secret_before_running
COOKIE_SECURE=0

# Comma-separated NSE market holidays in YYYY-MM-DD format; update each year.
NSE_HOLIDAYS=

# Mandatory SOP controls (paper trading only)
TRADING_CAPITAL_INR=100000
MAX_RISK_PER_TRADE_PCT=1.5
# ATR = dynamic stop model (1.5x ATR / support); FIXED = 4.5% stop model
SOP_STOP_MODEL=ATR
SOP_FIXED_STOP_PCT=4.5
SOP_MIN_DELIVERY_VOLUME_RATIO=1.2
SOP_BREAKOUT_VOLUME_MULTIPLE=2.0
SOP_MAX_BASE_WIDTH_PCT=12
# External NSE/company checks are fail-closed and must be supplied daily in this CSV.
SOP_EXTERNAL_CHECKS_FILE=data/sop_external_checks.csv

# Post-close price snapshots use the NSE website quote endpoint (best-effort, unofficial API).
# Snapshot job runs daily at 15:45 IST and stores data/closing_prices.json.
